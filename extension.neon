parametersSchema:
    wirestan: structure([
        reservedProperties: listOf(string())
        authorizationMethods: listOf(string())
        viewPaths: listOf(string())
        viewNamespaces: arrayOf(listOf(string()), string())
    ])

parameters:
    wirestan:
        # Properties that configure Livewire rather than hold component state, so
        # LockedPublicPropertyRule doesn't ask for #[Locked] on them. They should be
        # protected: a public one is client-editable, which is what
        # PublicReservedPropertyRule reports.
        reservedProperties:
            - listeners
            - rules
            - messages
            - validationAttributes
            - validationCustomValues
            - queryString
            - paginationTheme
        # Your own method or function names that count as an authorization check,
        # for guards ModelParamWithoutAuthorizationRule can't see, such as those
        # defined on a parent class.
        authorizationMethods: []
        # Where LockedPublicPropertyRule looks for the Blade views a component renders,
        # so it doesn't ask for #[Locked] on a property bound with wire:model.
        viewPaths:
            - %currentWorkingDirectory%/resources/views
        # The directories for each view namespace, such as `shop` in `shop::cart`, so
        # LockedPublicPropertyRule can read those views too.
        viewNamespaces: []

services:
    -
        class: BoringO11y\Wirestan\PhpStan\LivewireComponentReflectionDetector
    -
        class: BoringO11y\Wirestan\PhpStan\AuthorizationGuardDetector
        arguments:
            authorizationMethods: %wirestan.authorizationMethods%
    -
        class: BoringO11y\Wirestan\PhpStan\ComponentViews
        arguments:
            viewPaths: %wirestan.viewPaths%
            viewNamespaces: %wirestan.viewNamespaces%
    -
        class: BoringO11y\Wirestan\PhpStan\Rules\LockedPublicPropertyRule
        arguments:
            reservedProperties: %wirestan.reservedProperties%
        tags:
            - phpstan.rules.rule
    -
        class: BoringO11y\Wirestan\PhpStan\Rules\PublicReservedPropertyRule
        tags:
            - phpstan.rules.rule
    -
        class: BoringO11y\Wirestan\PhpStan\Rules\ComputedCacheScopeRule
        tags:
            - phpstan.rules.rule
    -
        class: BoringO11y\Wirestan\PhpStan\Rules\ModelParamWithoutAuthorizationRule
        tags:
            - phpstan.rules.rule
    -
        class: BoringO11y\Wirestan\PhpStan\Rules\ValidationNeverEnforcedRule
        tags:
            - phpstan.rules.rule
    -
        class: BoringO11y\Wirestan\PhpStan\Rules\LockedUrlConflictRule
        tags:
            - phpstan.rules.rule
    -
        class: BoringO11y\Wirestan\PhpStan\Rules\LegacyComputedAccessorRule
        tags:
            - phpstan.rules.rule
    -
        class: BoringO11y\Wirestan\PhpStan\Rules\AuthorizeTargetRule
        tags:
            - phpstan.rules.rule
    -
        class: BoringO11y\Wirestan\PhpStan\Rules\ReactiveMutationRule
        tags:
            - phpstan.rules.rule
    -
        class: BoringO11y\Wirestan\PhpStan\Rules\AsyncMutationRule
        tags:
            - phpstan.rules.rule
    -
        class: BoringO11y\Wirestan\PhpStan\Rules\ReservedActionNameRule
        tags:
            - phpstan.rules.rule
    -
        class: BoringO11y\Wirestan\PhpStan\Rules\ComputedMisuseRule
        tags:
            - phpstan.rules.rule
    -
        class: BoringO11y\Wirestan\PhpStan\Rules\ResetTargetRule
        tags:
            - phpstan.rules.rule
    -
        class: BoringO11y\Wirestan\PhpStan\Rules\NonPersistedStateRule
        tags:
            - phpstan.rules.rule
