{
    "name": "boring-o11y/wirestan",
    "description": "PHPStan rules for Livewire components: catches client-tamperable state, missing authorization, cached data leaking across users, and validation that never runs.",
    "type": "phpstan-extension",
    "keywords": [
        "phpstan",
        "larastan",
        "static-analysis",
        "laravel",
        "livewire",
        "security",
        "phpstan-extension",
        "phpstan-rules"
    ],
    "homepage": "https://github.com/boring-o11y/wirestan",
    "license": "MIT",
    "authors": [
        {
            "name": "Boring Observability",
            "email": "tech@boring-observability.dev",
            "homepage": "https://github.com/boring-o11y"
        }
    ],
    "support": {
        "issues": "https://github.com/boring-o11y/wirestan/issues",
        "source": "https://github.com/boring-o11y/wirestan"
    },
    "require": {
        "php": "^8.4",
        "nikic/php-parser": "^4.18 || ^5.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0"
    },
    "suggest": {
        "phpstan/phpstan": "Required to use these rules",
        "phpstan/extension-installer": "Auto-registers extension.neon so you don't have to include it by hand",
        "larastan/larastan": "Recommended host extension; these rules are designed to run alongside it"
    },
    "autoload": {
        "psr-4": {
            "BoringO11y\\Wirestan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BoringO11y\\Wirestan\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Fixtures"
        ]
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
